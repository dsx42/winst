{
  "_manifestVersion": "2026.9.16",
  "apps": [
    {
      "id": "winst",
      "name": "winst",
      "description": "Windows 软件安装与管理",
      "homepage": "https://github.com/dsx42/winst",
      "type": "portable",
      "source": {
        "kind": "github",
        "repo": "dsx42/winst",
        "files": [
          "winst.ps1"
        ]
      },
      "stripTopDir": false,
      "mainExe": "winst.ps1",
      "addToPath": true,
      "detect": {
        "method": "cliVersion",
        "versionArgs": "-v",
        "versionKind": "semver"
      }
    },
    {
      "id": "7-Zip-Extra",
      "name": "7-Zip Extra",
      "description": "解压引擎（winst 解压软件包时使用；命令行版，无需安装、不写系统项）",
      "homepage": "https://www.7-zip.org/",
      "type": "portable",
      "source": {
        "kind": "github",
        "repo": "ip7z/7zip",
        "files": [
          { "file": "7z*-extra.7z" }
        ]
      },
      "stripTopDir": false,
      "mainExe": "x64\\7za.exe",
      "detect": {
        "method": "cliVersion",
        "versionArgs": "--help",
        "versionKind": "semver"
      }
    },
    {
      "id": "FluxDown-CLI",
      "name": "FluxDown CLI",
      "description": "下载引擎（winst 下载软件包时使用；命令行版，无需安装、不写系统项）",
      "homepage": "https://fluxdown.zerx.dev/docs/zh/api/cli/",
      "type": "portable",
      "source": {
        "kind": "github",
        "repo": "zerx-lab/FluxDown",
        "releaseTag": "cli-v",
        "files": [
          {
            "url": "FluxDown-CLI-{version}-windows-x64.zip",
            "hashFile": "https://github.com/zerx-lab/FluxDown/releases/download/cli-v{version}/SHA256SUMS.txt",
            "hashFrom": "sha256sums"
          }
        ]
      },
      "stripTopDir": true,
      "mainExe": "fluxdown.exe"
    },
    {
      "id": "7-Zip",
      "name": "7-Zip",
      "description": "7-Zip 完整安装版",
      "homepage": "https://www.7-zip.org/",
      "type": "installer",
      "source": {
        "kind": "github",
        "repo": "ip7z/7zip",
        "files": [
          { "file": "7z*-x64.exe" }
        ]
      },
      "installArgs": "/S",
      "uninstallArgs": "/S",
      "detect": {
        "method": "registry",
        "name": "*7-Zip*"
      }
    },
    {
      "id": "FluxDown",
      "name": "FluxDown",
      "description": "FluxDown 图形界面版",
      "homepage": "https://github.com/zerx-lab/FluxDown",
      "type": "portable",
      "source": {
        "kind": "github",
        "repo": "zerx-lab/FluxDown",
        "releaseTag": "v",
        "files": [
          {
            "url": "FluxDown-{version}-windows-x64-portable.zip",
            "hashFile": "https://github.com/zerx-lab/FluxDown/releases/download/v{version}/SHA256SUMS.txt",
            "hashFrom": "sha256sums"
          }
        ]
      },
      "stripTopDir": true,
      "keep": [ "portable_data" ],
      "mainExe": "flux_down.exe",
      "shortcuts": { "desktop": true, "startMenu": true }
    },
    {
      "id": "vlmcsd",
      "name": "vlmcsd",
      "description": "KMS 模拟服务",
      "homepage": "https://github.com/Wind4/vlmcsd",
      "type": "download",
      "source": {
        "kind": "github",
        "repo": "Wind4/vlmcsd",
        "files": [
          "binaries.tar.gz"
        ]
      }
    },
    {
      "id": "Rufus",
      "name": "Rufus",
      "description": "USB 启动盘制作工具",
      "homepage": "https://rufus.ie/",
      "type": "exe",
      "source": {
        "kind": "github",
        "repo": "pbatard/rufus",
        "files": [
          "rufus-{version}.exe"
        ]
      },
      "postInstallCopy": [
        { "from": "rufus-{version}.exe", "to": "rufus.exe", "move": true }
      ],
      "shortcuts": { "desktop": false, "startMenu": true },
      "detect": {
        "method": "cliVersion",
        "versionArgs": "--help",
        "versionKind": "semver"
      }
    },
    {
      "id": "ventoy",
      "name": "Ventoy",
      "description": "多合一可启动 U 盘制作工具",
      "homepage": "https://www.ventoy.net/",
      "type": "portable",
      "source": {
        "kind": "github",
        "repo": "ventoy/Ventoy",
        "files": [
          "ventoy-{version}-windows.zip"
        ]
      },
      "stripTopDir": true,
      "postInstallCopy": [
        { "from": "altexe\\Ventoy2Disk_X64.exe", "to": "Ventoy2Disk_X64.exe" }
      ],
      "mainExe": "Ventoy2Disk_X64.exe",
      "shortcuts": { "desktop": false, "startMenu": true },
      "detect": {
        "method": "markerFile",
        "pathGlob": "{installDir}\\ventoy\\version",
        "versionKind": "semver"
      }
    },
    {
      "id": "Win11",
      "name": "Windows 11 商业版",
      "description": "Windows 11 安装镜像（BitTorrent，仅下载）",
      "type": "download",
      "source": {
        "kind": "magnet",
        "versionBetween": [ "version_", "_x64" ],
        "files": [
          {
            "url": "magnet:?xt=urn:btih:3c0f010837eebdd7b56af3249d913de82a3ea905&dn=zh-cn_windows_11_business_editions_version_26h1_updated_aug_2026_x64_dvd_c2bc5d06.iso&xl=8403775488",
            "hash": "204F9D176360C9C6F337C5956BDB713CFD35A0EF93A697C30F395828547408F1"
          }
        ]
      }
    },
    {
      "id": "ODT",
      "name": "Office Deployment Tool",
      "description": "Office 部署工具",
      "homepage": "https://www.microsoft.com/en-us/download/details.aspx?id=49117",
      "type": "download",
      "source": {
        "kind": "page",
        "pageUrl": "https://www.microsoft.com/en-us/download/details.aspx?id=49117",
        "link": { "class": "dlcdetail__download-btn", "text": "Download" },
        "files": [
          { "file": "*.exe" }
        ],
        "versionKey": "version"
      }
    },
    {
      "id": "jdk8",
      "name": "Eclipse Temurin JDK 8",
      "description": "Java 开发工具包（JDK）8",
      "homepage": "https://adoptium.net/",
      "type": "portable",
      "source": {
        "kind": "github",
        "repo": "adoptium/temurin8-binaries",
        "files": [
          { "file": "OpenJDK8U-jdk_x64_windows_hotspot_*.zip" }
        ]
      },
      "versionRewrite": { "from": "jdk8u{u}-b{b}", "to": "1.8.0_{u}-b{b}" },
      "stripTopDir": true,
      "mainExe": "bin\\java.exe",
      "addToPath": [ "%JAVA_HOME%\\bin" ],
      "env": {
        "JAVA_HOME": "{installDir}",
        "CLASSPATH": ".;%JAVA_HOME%\\lib;"
      },
      "detect": {
        "method": "cliVersion",
        "versionArgs": "-version",
        "versionBetween": [ "(build ", ")" ]
      }
    },
    {
      "id": "jdk21",
      "name": "Eclipse Temurin JDK 21",
      "description": "Java 开发工具包（JDK）21",
      "homepage": "https://adoptium.net/",
      "type": "portable",
      "source": {
        "kind": "github",
        "repo": "adoptium/temurin21-binaries",
        "files": [
          { "file": "OpenJDK21U-jdk_x64_windows_hotspot_*.zip" }
        ]
      },
      "versionRewrite": { "stripPrefix": "jdk-" },
      "stripTopDir": true,
      "mainExe": "bin\\java.exe",
      "addToPath": [ "%JAVA_HOME%\\bin" ],
      "env": {
        "JAVA_HOME": "{installDir}",
        "CLASSPATH": ".;%JAVA_HOME%\\lib;"
      },
      "detect": {
        "method": "cliVersion",
        "versionArgs": "-version",
        "versionBetween": [ "Temurin-", " " ]
      }
    },
    {
      "id": "jdk25",
      "name": "Eclipse Temurin JDK 25",
      "description": "Java 开发工具包（JDK）25",
      "homepage": "https://adoptium.net/",
      "type": "portable",
      "source": {
        "kind": "github",
        "repo": "adoptium/temurin25-binaries",
        "files": [
          { "file": "OpenJDK25U-jdk_x64_windows_hotspot_*.zip" }
        ]
      },
      "versionRewrite": { "stripPrefix": "jdk-" },
      "stripTopDir": true,
      "mainExe": "bin\\java.exe",
      "addToPath": [ "%JAVA_HOME%\\bin" ],
      "env": {
        "JAVA_HOME": "{installDir}",
        "CLASSPATH": ".;%JAVA_HOME%\\lib;"
      },
      "detect": {
        "method": "cliVersion",
        "versionArgs": "-version",
        "versionBetween": [ "Temurin-", " " ]
      }
    },
    {
      "id": "python3",
      "name": "Python 3",
      "description": "Python 解释器（官方完整版 zip，安装后引导 pip）",
      "homepage": "https://www.python.org/",
      "type": "portable",
      "source": {
        "kind": "listing",
        "indexUrl": "https://www.python.org/ftp/python/",
        "versionKind": "semver",
        "versionFilter": "3.*",
        "files": [
          "https://www.python.org/ftp/python/{version}/python-{version}-amd64.zip"
        ]
      },
      "stripTopDir": false,
      "mainExe": "python.exe",
      "addToPath": [ "%PYTHON_HOME%", "%PYTHON_HOME%\\Scripts" ],
      "env": { "PYTHON_HOME": "{installDir}" },
      "postInstall": [
        { "exe": "python.exe", "args": "-m pip install --upgrade --force-reinstall pip", "timeoutSec": 600 }
      ],
      "detect": {
        "method": "cliVersion",
        "versionArgs": "-version",
        "versionBetween": [ "Python ", " " ]
      }
    },
    {
      "id": "node24",
      "name": "Node.js 24",
      "description": "Node.js 运行时（含 npm）",
      "homepage": "https://nodejs.org/",
      "type": "portable",
      "source": {
        "kind": "listing",
        "indexUrl": "https://nodejs.org/dist/latest-v24.x/",
        "versionKind": "semver",
        "versionFilter": "24.*",
        "files": [
          "https://nodejs.org/dist/latest-v24.x/node-v{version}-win-x64.zip"
        ]
      },
      "stripTopDir": true,
      "mainExe": "node.exe",
      "addToPath": [ "%NODE_HOME%" ],
      "env": { "NODE_HOME": "{installDir}" },
      "detect": {
        "method": "cliVersion",
        "versionArgs": "-v",
        "versionKind": "semver"
      }
    },
    {
      "id": "Graphviz",
      "name": "Graphviz",
      "description": "图形可视化工具（dot / gvedit）",
      "homepage": "https://graphviz.org/",
      "type": "portable",
      "source": {
        "kind": "page",
        "pageUrl": "https://www.graphviz.org/download/",
        "link": {
          "text": "(64-bit) ZIP archive",
          "href": "https://gitlab.com/api/v4/projects/4207231/packages/generic/graphviz-releases/*"
        },
        "files": [
          { "file": "*-win64.zip" }
        ],
        "versionKind": "semver"
      },
      "stripTopDir": true,
      "mainExe": "bin\\dot.exe",
      "addToPath": [ "{installDir}\\bin" ],
      "env": { "GRAPHVIZ_DOT": "{installDir}\\bin\\dot.exe" },
      "detect": {
        "method": "cliVersion",
        "versionArgs": "--version",
        "versionKind": "semver"
      }
    },
    {
      "id": "PlantUML",
      "name": "PlantUML",
      "description": "UML 图绘制工具（jar 包，需 JDK；用 java -jar plantuml.jar 调用）",
      "homepage": "https://plantuml.com/",
      "type": "exe",
      "source": {
        "kind": "github",
        "repo": "plantuml/plantuml",
        "files": [
          "plantuml-{version}.jar"
        ]
      },
      "postInstallCopy": [
        { "from": "plantuml-{version}.jar", "to": "plantuml.jar", "move": true }
      ],
      "detect": {
        "method": "cliVersion",
        "versionArgs": "--version",
        "versionBetween": [ "PlantUML version ", " " ]
      }
    },
    {
      "id": "idea",
      "name": "IntelliJ IDEA Ultimate",
      "description": "Java IDE（官方 Windows x64 ZIP 绿色版；附 Alabaster 主题）",
      "homepage": "https://www.jetbrains.com/idea/",
      "type": "portable",
      "source": {
        "kind": "json",
        "apiUrl": "https://data.services.jetbrains.com/products/releases?code=IIU&latest=true&type=release",
        "itemsKey": "IIU",
        "versionKey": "version",
        "files": [
          {
            "file": "*.win.zip",
            "urlKey": "downloads.windowsZip.link",
            "hashFileKey": "downloads.windowsZip.checksumLink"
          },
          {
            "url": "https://raw.githubusercontent.com/tonsky/intellij-alabaster/master/Alabaster.icls",
            "dest": "colors\\Alabaster.icls"
          },
          {
            "url": "https://raw.githubusercontent.com/tonsky/intellij-alabaster/master/Alabaster%20Dark.icls",
            "dest": "colors\\Alabaster Dark.icls"
          }
        ]
      },
      "stripTopDir": false,
      "mainExe": "bin\\idea64.exe",
      "shortcuts": { "desktop": true, "startMenu": true },
      "detect": {
        "method": "jsonFile",
        "pathGlob": "{installDir}\\product-info.json",
        "jsonKey": "version"
      }
    },
    {
      "id": "vscode",
      "name": "Visual Studio Code",
      "description": "代码编辑器（官方 Windows x64 绿色版 zip）",
      "homepage": "https://code.visualstudio.com/",
      "type": "portable",
      "source": {
        "kind": "json",
        "apiUrl": "https://code.visualstudio.com/sha/",
        "itemsKey": "products",
        "versionKey": "productVersion",
        "files": [
          {
            "file": "VSCode-win32-x64-*.zip",
            "urlKey": "url",
            "hashKey": "sha256hash"
          }
        ]
      },
      "stripTopDir": false,
      "mainExe": "Code.exe",
      "shortcuts": { "desktop": true, "startMenu": true },
      "detect": {
        "method": "fileVersion",
        "pathGlob": "{installDir}\\Code.exe"
      }
    },
    {
      "id": "Notepad3",
      "name": "Notepad3",
      "description": "轻量文本编辑器（便携版）",
      "homepage": "https://www.rizonesoft.com/downloads/notepad3/",
      "type": "portable",
      "source": {
        "kind": "github",
        "repo": "rizonesoft/Notepad3",
        "files": [
          { "file": "Notepad3_*_x64_Portable.zip" }
        ]
      },
      "versionRewrite": { "stripPrefix": "RELEASE_" },
      "stripTopDir": false,
      "mainExe": "Notepad3.exe",
      "shortcuts": { "desktop": false, "startMenu": true },
      "detect": {
        "method": "fileVersion",
        "pathGlob": "{installDir}\\Notepad3.exe"
      }
    },
    {
      "id": "MemoryAnalyzer",
      "name": "Eclipse Memory Analyzer",
      "description": "Java 堆转储（heap dump）分析工具（RCP 绿色版，需 JDK 21+）",
      "homepage": "https://eclipse.dev/mat/",
      "type": "portable",
      "source": {
        "kind": "page",
        "pageUrl": "https://eclipse.dev/mat/download/",
        "link": { "text": "Windows (x86_64)" },
        "files": [
          { "file": "*.zip", "name": "MemoryAnalyzer-{version}.zip" }
        ],
        "versionFrom": "page",
        "versionBetween": [ "Version:</strong> ", " " ]
      },
      "stripTopDir": true,
      "mainExe": "MemoryAnalyzer.exe",
      "shortcuts": { "desktop": false, "startMenu": true },
      "detect": { "method": "none" }
    },
    {
      "id": "opencode",
      "name": "opencode",
      "description": "终端里的 AI 编程助手（命令行）",
      "homepage": "https://github.com/anomalyco/opencode",
      "type": "portable",
      "source": {
        "kind": "github",
        "repo": "anomalyco/opencode",
        "files": [
          "opencode-windows-x64.zip"
        ]
      },
      "stripTopDir": false,
      "mainExe": "opencode.exe",
      "addToPath": true,
      "detect": {
        "method": "cliVersion",
        "versionArgs": "--version",
        "versionKind": "semver"
      }
