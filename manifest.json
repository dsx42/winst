{
  "_manifestVersion": "2026.9.18",
  "apps": [
    {
      "id": "winst",
      "name": "winst",
      "description": "Windows 软件安装与管理",
      "dependencies": [ "7-Zip-Extra", "FluxDown-CLI" ],
      "homepage": "https://github.com/dsx42/winst",
      "type": "portable",
      "source": {
        "kind": "github",
        "repo": "dsx42/winst",
        "files": [
          "winst.ps1"
        ]
      },
      "stripTopDir": false,
      "mainExe": "winst.ps1",
      "addToPath": true,
      "detect": {
        "method": "cliVersion",
        "versionArgs": "-v",
        "versionKind": "semver"
      }
    },
    {
      "id": "7-Zip-Extra",
      "name": "7-Zip Extra",
      "description": "解压引擎（winst 解压软件包时使用；命令行版，无需安装、不写系统项）",
      "group": "7-Zip",
      "homepage": "https://www.7-zip.org/",
      "type": "portable",
      "source": {
        "kind": "github",
        "repo": "ip7z/7zip",
        "files": [
          { "file": "7z*-extra.7z" }
        ]
      },
      "stripTopDir": false,
      "mainExe": "x64\\7za.exe",
      "detect": {
        "method": "cliVersion",
        "versionArgs": "--help",
        "versionKind": "semver"
      }
    },
    {
      "id": "FluxDown-CLI",
      "name": "FluxDown CLI",
      "description": "下载引擎（winst 下载软件包时使用；命令行版，无需安装、不写系统项）",
      "group": "FluxDown",
      "homepage": "https://fluxdown.zerx.dev/docs/zh/api/cli/",
      "type": "portable",
      "source": {
        "kind": "github",
        "repo": "zerx-lab/FluxDown",
        "releaseTag": "cli-v",
        "files": [
          {
            "url": "FluxDown-CLI-{version}-windows-x64.zip",
            "hashFile": "https://github.com/zerx-lab/FluxDown/releases/download/cli-v{version}/SHA256SUMS.txt",
            "hashFrom": "sha256sums"
          }
        ]
      },
      "stripTopDir": true,
      "mainExe": "fluxdown.exe"
    }
  ]
}
